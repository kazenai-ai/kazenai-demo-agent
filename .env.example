# Example .env for kazenai-demo-agent. Never commit real keys.
# Only needed for `--live` runs of examples 14-20; every example runs offline without them.
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Optional: models used by --live (must be in KazenAI's price table)
# KAZENAI_DEMO_OPENAI_MODEL=gpt-4o-mini
# KAZENAI_DEMO_ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: example 20 against a running LiteLLM proxy
# KAZENAI_DEMO_LITELLM_URL=http://127.0.0.1:4000
# KAZENAI_DEMO_LITELLM_KEY=your-litellm-key

# Optional: hosted example 03 (staging Agent FinOps)
# KAZENAI_FINOPS_API_KEY=your-kazenai-key
AGENT_ID=demo-researcher
